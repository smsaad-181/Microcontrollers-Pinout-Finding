{
  "name": "pinout-finder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "catalog:validate": "tsx --conditions=@pinout/source --tsconfig packages/cli/tsconfig.json packages/cli/src/main.ts validate",
    "catalog:compile": "tsx --conditions=@pinout/source --tsconfig packages/cli/tsconfig.json packages/cli/src/main.ts compile",
    "docs:schema": "pnpm --filter @pinout/schema build && pnpm --filter @pinout/schema docs",
    "mutation": "pnpm -r --workspace-concurrency=1 --if-present run mutation",
    "check:rules-disabled": "node tools/checks/rules-disabled.mjs",
    "check:boundaries": "node tools/checks/boundaries.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
