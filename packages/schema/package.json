{
  "name": "@pinout/schema",
  "version": "0.0.0",
  "private": true,
  "description": "Zod schemas for the evidence-backed pinout catalog.",
  "type": "module",
  "exports": {
    ".": {
      "@pinout/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/emit-json-schema.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "docs": "node scripts/emit-docs.mjs"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
